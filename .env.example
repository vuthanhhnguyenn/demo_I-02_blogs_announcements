NEXT_PUBLIC_APP_ENV="development" ##"development" or "production". Only "development" renders dev-only tooling such as the header's デモ: ユーザー切替 switcher — set it to "production" on any deployed environment.
NEXT_PUBLIC_API_URL="http://localhost:3000/api" ##YOUR_API_URL
NEXT_PUBLIC_OPENAPI_GENERATOR_URL="http://localhost:3000/api/openapi.json"
NEXT_PUBLIC_IMAGE_DOMAINS="example1.com, example2.com"
NEXT_PUBLIC_REAL_API_URL="http://localhost:8000" ##Real fitness-api backend base URL (used by src/lib/api-real)

##AUTH
NEXT_PUBLIC_GOOGLE_CLIENT_ID="" ##Google Cloud OAuth 2.0 Client ID, CRM origin authorized
NEXT_PUBLIC_COGNITO_CLIENT_ID="" ##Cognito User Pool App Client ID (USER_PASSWORD_AUTH enabled)
NEXT_PUBLIC_COGNITO_REGION="" ##AWS region of the Cognito User Pool, e.g. ap-northeast-1
